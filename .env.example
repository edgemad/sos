# ── Archil — persistent shared filesystem ──────────────────────
# Create a key in the Archil console, then copy this file to .env
# (git-ignored) or set these in your secret store.
#   https://console.archil.com/?utm_source=freebuff&utm_medium=paid&utm_campaign=archil
#
# Never commit real keys; .env and .env.* are already git-ignored.
# The key is read by the `disk` CLI and by the `disk` Node package.

# Archil API key — no default, never hardcode it in source.
ARCHIL_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Region. Serverless `exec` is AWS-only today; choose the one
# closest to where your compute runs:
#   aws-us-east-1 | aws-us-west-2 | aws-eu-west-1
ARCHIL_REGION=aws-us-east-1
